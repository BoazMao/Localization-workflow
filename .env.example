# Provider credentials are introduced in their implementation milestones.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=
TRANSLATION_API_KEY=

# Optional override. By default the app uses the operating system's user-data folder.
LOCALIZATION_WORKFLOW_DATA_DIR=
FFMPEG_PATH=
FFPROBE_PATH=

# Local Const-me/Whisper integration. Use Windows PowerShell 5.1, not PowerShell Core.
WHISPER_MODEL_PATH=
WHISPER_MODULE_PATH=
WHISPER_CLI_PATH=
WINDOWS_POWERSHELL_PATH=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
